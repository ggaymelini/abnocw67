{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "ws"]
  },
  "include": ["src/**/*.ts", "../src/lib/mp/**/*.ts", "../src/lib/sim/settings.ts"]
}
